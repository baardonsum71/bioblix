# =============================================================================
# BioBlix — client env (EXPO_PUBLIC_* is inlined at build time)
# Local: copy to `.env` in project root, then restart `npx expo start`
# Vercel: Project → Settings → Environment Variables (Production + Preview)
#          Use the SAME EXPO_PUBLIC_* names — then Redeploy so Metro rebuilds
# =============================================================================

# --- Clerk (web + native) ---
# Dashboard → API Keys → Publishable key
# Also enable Native applications: https://dashboard.clerk.com/~/native-applications
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Absolute API origin for native (web uses same-origin). Example: https://bioblix.app
EXPO_PUBLIC_API_BASE_URL=

# Optional local author id when signed out (feed tooling only)
EXPO_PUBLIC_DEV_USER_ID=

# --- Firebase Web App (Console → Project settings → Your apps → Web) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- RevenueCat (optional on web; entitlement must be: pro_yearly) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# =============================================================================
# Server-only (Vercel Functions /api/*) — NEVER prefix with EXPO_PUBLIC_
# These must NOT be committed; set only in Vercel dashboard / local .env
# =============================================================================
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-long-random-secret
FIREBASE_SERVICE_ACCOUNT_JSON=
# Clerk secret (Dashboard → API Keys) — used by /api/clerk-firebase-token
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Cloudflare R2 (S3-compatible) — preferred media upload until Firebase Storage/Blaze is ready
# Dashboard → R2 → Manage R2 API Tokens + bucket public URL (r2.dev or custom domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bioblix-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
