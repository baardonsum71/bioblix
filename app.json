{
  "expo": {
    "name": "BioBlix",
    "slug": "bioblix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-mark.jpg",
    "scheme": "bioblix",
    "userInterfaceStyle": "dark",
    "primaryColor": "#2EE6FF",
    "description": "BioBlix helps makers showcase apps and products in short vertical blix — with optional Pro outbound links to your store or landing page.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bioblix.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "BioBlix",
        "NSPhotoLibraryUsageDescription": "BioBlix bruker bildebiblioteket ditt bare når du velger bilde eller video til et nytt produkt-blix.",
        "NSPhotoLibraryAddUsageDescription": "BioBlix lagrer ikke til biblioteket med mindre du eksporterer eget innhold.",
        "LSApplicationQueriesSchemes": ["https", "http"]
      }
    },
    "android": {
      "package": "com.bioblix.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/images/logo-mark.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "BioBlix",
      "shortName": "BioBlix",
      "description": "Korte produkt-blix for apper og varer — med Pro-lenker når du er klar til å selge.",
      "themeColor": "#050508",
      "backgroundColor": "#050508"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050508"
        }
      ],
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "BioBlix trenger tilgang til bilder og videoer for at du skal kunne publisere produkt-blix."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
