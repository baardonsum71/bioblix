rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPostOwner() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    function isCreatingOwnPost() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    /** Mirrored from RevenueCat via trusted webhook / Admin SDK — never set by clients. */
    function callerIsProYearly() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isProYearly', false) == true;
    }

    /** Time-limited Pro from coin redeem (Admin SDK sets coinProUntil). */
    function callerHasCoinPro() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['coinProUntil'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coinProUntil is timestamp
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coinProUntil > request.time;
    }

    function callerCanUseLinks() {
      return callerIsProYearly() || callerHasCoinPro();
    }

    function hasNonEmptyLinkUrl() {
      return request.resource.data.keys().hasAll(['linkUrl'])
        && request.resource.data.linkUrl is string
        && request.resource.data.linkUrl.size() > 0;
    }

    function linkUrlAllowedOnWrite() {
      return !hasNonEmptyLinkUrl() || callerCanUseLinks();
    }

    /** Public profile social/external links — max 10, free for all users. */
    function profileLinksOk() {
      return !('profileLinks' in request.resource.data)
        || (
          request.resource.data.profileLinks is list
          && request.resource.data.profileLinks.size() <= 10
        );
    }

    /**
     * Vanity handle lock: doc id = handle (e.g. usernames/gamingper).
     * Create-once — prevents two accounts claiming the same BioBlix URL.
     */
    match /usernames/{username} {
      allow read: if true;

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && username.size() >= 3
        && username.size() <= 24
        && username.matches('^[a-z0-9][a-z0-9_.-]*[a-z0-9]$');

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.clerkId == userId
        && request.resource.data.get('isProYearly', false) == false
        && request.resource.data.get('subscriptionTier', 'standard') == 'standard'
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('coinsSignupBonusGranted', false) == false
        && !('coinProUntil' in request.resource.data
          && request.resource.data.coinProUntil != null)
        && profileLinksOk();

      // Clients may update profile + blockedUsers, but never flip Pro/coins themselves.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.isProYearly == resource.data.get('isProYearly', false)
        && request.resource.data.subscriptionTier == resource.data.get('subscriptionTier', 'standard')
        && request.resource.data.get('coins', 0) == resource.data.get('coins', 0)
        && request.resource.data.get('coinsSignupBonusGranted', false)
          == resource.data.get('coinsSignupBonusGranted', false)
        && request.resource.data.get('coinProUntil', null)
          == resource.data.get('coinProUntil', null)
        && profileLinksOk();

      allow delete: if false;
    }

    match /coin_ledger/{entryId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isCreatingOwnPost()
        && request.resource.data.mediaType in ['video', 'image']
        && request.resource.data.keys().hasAll([
          'userId', 'mediaUrl', 'mediaType', 'title', 'description', 'createdAt'
        ])
        && (!('tags' in request.resource.data)
          || (request.resource.data.tags is list
            && request.resource.data.tags.size() <= 5))
        && linkUrlAllowedOnWrite();

      // Owner may edit content; anyone signed-in may bump like/comment counters only.
      allow update: if (
          isPostOwner()
          && request.resource.data.userId == resource.data.userId
          && linkUrlAllowedOnWrite()
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && (
            request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
          )
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount'])
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount
            == resource.data.get('commentCount', 0) + 1
        );

      allow delete: if isPostOwner();

      match /likes/{likerId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == likerId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == likerId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasAll(['userId', 'text', 'createdAt']);
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    /** Tag popularity docs — readable by all; signed-in may create/increment. */
    match /tags/{tagId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'postCount', 'updatedAt'])
        && request.resource.data.name == tagId
        && request.resource.data.postCount == 1
        && tagId.size() >= 2
        && tagId.size() <= 24;

      allow update: if signedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.name == tagId
        && request.resource.data.postCount is int
        && request.resource.data.postCount == resource.data.postCount + 1;

      allow delete: if false;
    }

    /** Social graph — follower may create/delete own follow edges. */
    match /follows/{followId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0
        && request.resource.data.followerId != request.resource.data.followingId
        && request.resource.data.keys().hasAll([
          'followerId', 'followingId', 'createdAt'
        ])
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    /** Live sessions — public read while live; host writes via Admin API (clients read-only). */
    match /lives/{liveId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /** UGC reports — create-only for signed-in reporters. */
    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'postId', 'reportedUserId', 'reporterId', 'createdAt'
        ])
        && request.resource.data.postId is string
        && request.resource.data.reportedUserId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.reportedUserId.size() > 0;
      allow update, delete: if false;
    }
  }
}
